<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Budget_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Blocks saving a campaign with a negative budget.</description>
    <errorConditionFormula>Budget__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Budget__c</errorDisplayField>
    <errorMessage>Budget cannot be negative.</errorMessage>
</ValidationRule>
